{
  "name": "scatcode-text",
  "version": "0.1.0",
  "description": "React component for rendering Scatcode-encoded text",
  "type": "module",
  "main": "./dist/scatcode-text.umd.js",
  "module": "./dist/scatcode-text.es.js",
  "exports": {
    ".": {
      "import": "./dist/scatcode-text.es.js",
      "require": "./dist/scatcode-text.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "scatcode",
    "text-encoding"
  ],
  "author": "Hiroshi Ichikawa",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "scatcode-core": "^0.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^6.0.5"
  }
}
