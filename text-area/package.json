{
  "name": "scatcode-text-area",
  "version": "0.1.0",
  "description": "React component providing an editable text area for Scatcode-encoded text",
  "type": "module",
  "main": "./dist/scatcode-text-area.umd.js",
  "module": "./dist/scatcode-text-area.es.js",
  "exports": {
    ".": {
      "import": "./dist/scatcode-text-area.es.js",
      "require": "./dist/scatcode-text-area.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "scatcode",
    "text-encoding"
  ],
  "author": "Hiroshi Ichikawa",
  "license": "GPL-3.0-only",
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@ckeditor/ckeditor5-react": "^11.0.0",
    "ckeditor5": "^47.2.0",
    "scatcode-core": "^0.1.0"
  },
  "devDependencies": {
    "vite": "^6.0.5"
  }
}
