{
  "name": "scatcode-core",
  "version": "0.1.0",
  "description": "Core library for Scatcode text encoding and parsing",
  "type": "module",
  "main": "./dist/scatcode-core.umd.js",
  "module": "./dist/scatcode-core.es.js",
  "exports": {
    ".": {
      "import": "./dist/scatcode-core.es.js",
      "require": "./dist/scatcode-core.umd.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "scatcode",
    "text-encoding"
  ],
  "author": "Hiroshi Ichikawa",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "vite": "^6.0.5"
  }
}
